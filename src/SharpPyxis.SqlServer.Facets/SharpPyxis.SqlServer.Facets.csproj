<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SharpPyxis.SqlServer.Facets</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The engine speaks to SQL Server and to nothing else: no MCP, no console. The host that exposes
         it is another project, so that this one is tested without a protocol in the way. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- SqlClient 7.1.1 brings Pkcs 9.0.18, under two advisories (GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx),
         fixed in 10.0.13. Referenced here only to raise it: drop the line once SqlClient brings a fixed version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!-- DPAPI, for the connection file: here rather than in the MCP server, so that another front reads the same file. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpPyxis.SqlServer.Facets.Tests" />
  </ItemGroup>

</Project>
